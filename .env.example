# Database Configuration (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# For production, use PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/lostfound"

# JWT Secret (minimum 16 characters, use a secure random string)
# Generate with: openssl rand -hex 32
JWT_SECRET="your-secure-jwt-secret-at-least-16-chars"

# Environment
NODE_ENV="development"
